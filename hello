<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Hello World</title>
<style>
  body { margin: 0; height: 100vh; background: #1a1a2e; font-family: sans-serif; overflow: hidden; }
  h1 { position: absolute; color: #e94560; font-size: 3rem; margin: 0; white-space: nowrap; }
  .buttons { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 12px; z-index: 10; }
  button { padding: 12px 24px; font-size: 1.2rem; border: none; border-radius: 8px; background: #e94560; color: white; cursor: pointer; transition: transform 0.2s; }
  button:hover { transform: scale(1.1); }
  .particle { position: absolute; width: 10px; height: 10px; border-radius: 50%; animation: fly 1s forwards; pointer-events: none; }
  @keyframes fly { to { transform: translateY(-200px) scale(0); opacity: 0; } }
</style>
</head>
<body>
  <h1 id="hello">Hello World!</h1>
  <div class="buttons">
    <button onclick="burst(event)">Click Me 🎉</button>
    <button onclick="changeColor()">Change BG 🎨</button>
  </div>
  <script>
    const h1 = document.getElementById('hello');
    let x = 100, y = 80, dx = 2, dy = 2;
    const colors = ['#1a1a2e','#16213e','#0f3460','#533483','#2c003e','#1b1b2f','#162447','#1f4068'];
    function animate() {
      x += dx; y += dy;
      const maxX = window.innerWidth - h1.offsetWidth;
      const maxY = window.innerHeight - h1.offsetHeight - 80;
      if (x <= 0 || x >= maxX) { dx = -dx; h1.style.color = `hsl(${Math.random()*360},80%,60%)`; }
      if (y <= 0 || y >= maxY) { dy = -dy; h1.style.color = `hsl(${Math.random()*360},80%,60%)`; }
      h1.style.left = x + 'px';
      h1.style.top = y + 'px';
      requestAnimationFrame(animate);
    }
    animate();
    function changeColor() {
      document.body.style.background = colors[Math.floor(Math.random() * colors.length)];
    }
    function burst(e) {
      for (let i = 0; i < 12; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = e.clientX + 'px';
        p.style.top = e.clientY + 'px';
        p.style.background = `hsl(${Math.random()*360},80%,60%)`;
        p.style.animation = `fly ${0.5+Math.random()}s forwards`;
        p.style.transform = `translate(${(Math.random()-0.5)*200}px, 0)`;
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 1200);
      }
    }
  </script>
</body>
</html>
