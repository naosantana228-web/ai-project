<!-- Main Content -->
<main class="main">
    <!-- Header -->
    <div class="header">
        <div class="header-title">
            <h2>Customer Engagement Dashboard</h2>
            <p>PulseFlow — Workflow Automation & Team Collaboration Platform</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-outline" onclick="exportData()">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Export
            </button>
            <button class="btn btn-primary" onclick="refreshData()">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- Interactive Filters -->
    <div class="filters-bar animate-in">
        <div class="filter-group">
            <label>Date Range</label>
            <select id="filterDateRange" onchange="applyFilters()">
                <option value="7d">Last 7 Days</option>
                <option value="30d" selected>Last 30 Days</option>
                <option value="90d">Last 90 Days</option>
                <option value="6m">Last 6 Months</option>
                <option value="1y">Last Year</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Customer Segment</label>
            <select id="filterSegment" onchange="applyFilters()">
                <option value="all">All Segments</option>
                <option value="enterprise">Enterprise (200+ seats)</option>
                <option value="midmarket">Mid-Market (50-199 seats)</option>
                <option value="startup">Startup (1-49 seats)</option>
            </select>
        </div>
        <div class="filter-group">
            <label>User Cohort</label>
            <select id="filterCohort" onchange="applyFilters()">
                <option value="all">All Cohorts</option>
                <option value="new">New (0-30 days)</option>
                <option value="active">Active (31-90 days)</option>
                <option value="mature">Mature (91-365 days)</option>
                <option value="veteran">Veteran (365+ days)</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Plan Tier</label>
            <select id="filterPlan" onchange="applyFilters()">
                <option value="all">All Plans</option>
                <option value="starter">Starter</option>
                <option value="professional">Professional</option>
                <option value="enterprise">Enterprise</option>
            </select>
        </div>
        <button class="filter-reset" onclick="resetFilters()">Reset Filters</button>
    </div>

    <!-- KPI Cards - Engagement Metrics -->
    <h3 class="section-title">Engagement Metrics</h3>
    <div class="kpi-grid animate-in delay-1">
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">DAU/MAU Ratio</span>
                <div class="kpi-icon" style="background:#EEF2FF;">
                    <svg width="18" height="18" fill="none" stroke="#4F46E5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
            </div>
            <div class="kpi-value" id="kpiDauMau">38.2%</div>
            <div class="kpi-change positive">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z"/></svg>
                +3.1% vs last period
