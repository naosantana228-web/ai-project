        `DAU/MAU Ratio,${document.getElementById('kpiDauMau').textContent}\n` +
        `Session Duration,${document.getElementById('kpiSessionDuration').textContent}\n` +
        `Feature Adoption,${document.getElementById('kpiFeatureAdoption').textContent}\n` +
        `Active Users,${document.getElementById('kpiActiveUsers').textContent}\n` +
        `Login Frequency,${document.getElementById('kpiLoginFreq').textContent}\n` +
        `Engagement Score,${document.getElementById('kpiEngScore').textContent}\n` +
        `At-Risk Accounts,${document.getElementById('kpiAtRisk').textContent}\n` +
        `Net Retention Rate,${document.getElementById('kpiNRR').textContent}\n` +
        `Email Open Rate,${document.getElementById('commEmailOpen').textContent}\n` +
        `In-App CTR,${document.getElementById('commInAppCTR').textContent}\n` +
        `Support Tickets,${document.getElementById('commTickets').textContent}\n`;

    const link = document.createElement('a');
    link.setAttribute('href', encodeURI(csvContent));
    link.setAttribute('download', 'pulseflow_engagement_report.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

