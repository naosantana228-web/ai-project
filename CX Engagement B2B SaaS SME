// HELPER FUNCTIONS
// ============================================================

function generateDateLabels(count, type = 'day') {
    const labels = [];
    const now = new Date();
    for (let i = count - 1; i >= 0; i--) {
        const d = new Date(now);
        if (type === 'day') {
            d.setDate(d.getDate() - i);
            labels.push(d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
        } else {
            d.setMonth(d.getMonth() - i);
            labels.push(d.toLocaleDateString('en-US', { month: 'short', year: '2-digit' }));
        }
    }
    return labels;
}

function generateTrendData(count, min, max, volatility) {
    const data = [];
    let current = (min + max) / 2;
    for (let i = 0; i < count; i++) {
        current += (Math.random() - 0.45) * (max - min) * volatility;
        current = Math.max(min, Math.min(max, current));
        data.push(parseFloat(current.toFixed(1)));
    }
    return data;
}

function populateRiskTable() {
    const tbody = document.getElementById('riskTableBody');
    tbody.innerHTML = riskAccounts.map(acc => `
        <tr>
            <td><strong>${acc.name}</strong></td>
            <td>${acc.segment}</td>
            <td>
                <div style="display:flex;align-items:center;gap:8px;">
                    <div class="progress-bar" style="width:80px;">
                        <div class="fill" style="width:${acc.score}%;background:${acc.score < 40 ? '#EF4444' : acc.score < 55 ? '#F59E0B' : '#10B981'}"></div>
                    </div>
                    <span>${acc.score}/100</span>
                </div>
            </td>
            <td>${acc.lastLogin}</td>
            <td style="color:${acc.trend < -30 ? '#EF4444' : acc.trend < -20 ? '#F59E0B' : '#64748B'}">${acc.trend}%</td>
            <td>
                <div class="risk-indicator">
                    <span class="risk-dot ${acc.risk}"></span>
                    <span>${acc.risk.charAt(0).toUpperCase() + acc.risk.slice(1)}</span>
                </div>
            </td>
            <td><span class="badge badge-${acc.risk === 'high' ? 'danger' : acc.risk === 'medium' ? 'warning' : 'info'}">${acc.risk === 'high' ? 'Needs Attention' : acc.risk === 'medium' ? 'Monitor' : 'Watchlist'}</span></td>
        </tr>
    `).join('');
}

// ============================================================
// FILTER LOGIC
// ============================================================

function applyFilters() {
    const segment = document.getElementById('filterSegment').value;
    const cohort = document.getElementById('filterCohort').value;
    const dateRange = document.getElementById('filterDateRange').value;

    let d = DATA[segment] || DATA.all;

    // Apply cohort modifier
    let modifier = 1;
    if (cohort === 'new') modifier = 0.82;
    else if (cohort === 'active') modifier = 1.05;
    else if (cohort === 'mature') modifier = 1.12;
    else if (cohort === 'veteran') modifier = 1.18;

    // Update KPIs
    document.getElementById('kpiDauMau').textContent = (d.dauMau * modifier).toFixed(1) + '%';
    document.getElementById('kpiSessionDuration').textContent = (d.sessionDuration * modifier).toFixed(1) + 'm';
    document.getElementById('kpiFeatureAdoption').textContent = (d.featureAdoption * modifier).toFixed(1) + '%';
    document.getElementById('kpiActiveUsers').textContent = Math.round(d.activeUsers * modifier).toLocaleString();
    document.getElementById('kpiLoginFreq').textContent = (d.loginFreq * modifier).toFixed(1) + '/wk';
    document.getElementById('kpiEngScore').textContent = Math.round(d.engScore * modifier) + '/100';
    document.getElementById('kpiAtRisk').textContent = Math.round(d.atRisk / modifier);
    document.getElementById('kpiNRR').textContent = Math.round(d.nrr * (modifier > 1 ? 1 + (modifier - 1) * 0.3 : modifier)) + '%';
    document.getElementById('commEmailOpen').textContent = (d.emailOpen * modifier).toFixed(1) + '%';
    document.getElementById('commInAppCTR').textContent = (d.inAppCTR * modifier).toFixed(1) + '%';
    document.getElementById('commTickets').textContent = Math.round(d.tickets / modifier);

    // Update journey
    document.getElementById('journeyActivation').textContent = (d.activation * modifier).toFixed(1) + '%';
    document.getElementById('journeyFirstValue').textContent = (d.firstValue * modifier).toFixed(1) + '%';
    document.getElementById('journeyHabit').textContent = (d.habit * modifier).toFixed(1) + '%';
    document.getElementById('journeyExpansion').textContent = (d.expansion * modifier).toFixed(1) + '%';
    document.getElementById('journeyAdvocacy').textContent = (d.advocacy * modifier).toFixed(1) + '%';

    // Update DAU/MAU chart
    const baseMin = d.dauMau - 8;
    const baseMax = d.dauMau + 5;
    let numDays = dateRange === '7d' ? 7 : dateRange === '30d' ? 30 : dateRange === '90d' ? 90 : dateRange === '6m' ? 180 : 365;
    charts.dauMau.data.labels = generateDateLabels(Math.min(numDays, 60));
    charts.dauMau.data.datasets[0].data = generateTrendData(Math.min(numDays, 60), baseMin * modifier, baseMax * modifier, 0.25);
    charts.dauMau.update();
}

function resetFilters() {
    document.getElementById('filterDateRange').value = '30d';
    document.getElementById('filterSegment').value = 'all';
    document.getElementById('filterCohort').value = 'all';
    document.getElementById('filterPlan').value = 'all';
    applyFilters();
}

function refreshData() {
    // Simulate data refresh with slight randomization
    DATA.all.dauMau = parseFloat((37 + Math.random() * 3).toFixed(1));
    DATA.all.sessionDuration = parseFloat((13.5 + Math.random() * 2.5).toFixed(1));
    DATA.all.activeUsers = Math.round(2750 + Math.random() * 200);
    applyFilters();

    // Visual feedback
    document.querySelectorAll('.kpi-card').forEach(card => {
        card.style.transform = 'scale(0.98)';
        setTimeout(() => card.style.transform = '', 200);
    });
}

